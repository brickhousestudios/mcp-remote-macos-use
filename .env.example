# MCP Remote macOS Control - Environment Configuration
# Copy this file to .env and fill in your values

# VNC Connection Settings (if using VNC for remote control)
MACOS_HOST=localhost
MACOS_PORT=5900
MACOS_VNC_PASSWORD=your_vnc_password_here
MACOS_VNC_USERNAME=
MACOS_VNC_ENCRYPTION=

# LiveKit Settings (if using LiveKit - optional)
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Logging Level
LOG_LEVEL=INFO
